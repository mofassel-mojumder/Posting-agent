# Posting Agent v1 - copy this file to .env and fill in your own values
# NEVER put a password in this file. NEVER share this file. NEVER commit .env
# chmod 600 .env on Linux/Mac. On Windows, keep it in this folder only.

# Set DRY_RUN=false only when you are ready to post for real
DRY_RUN=true

# Meta Graph API (official) - Facebook Page + Instagram
# Get these from Meta Business Suite / Meta for Developers, with your own login.
# The agent never asks for your Facebook password.
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_USER_ID=

# Instagram needs a public URL for the media file (Graph API rule).
# If you have a public link for the image or video, put it in the post folder
# as media_url.txt. If there is no public URL, Instagram stays as manual-ready
# in v1 and the dashboard tells you so. Nothing is faked as posted.

# LinkedIn API (official) - personal profile, scope w_member_social
# Get these from LinkedIn Developers, with your own login.
# The access token lives 60 days, then it must be renewed and put here again.
# The person URN looks like urn:li:person:AbCdEfGhIj, get it from
# GET https://api.linkedin.com/v2/userinfo with the same token.
# If either line is empty, LinkedIn stays manual_ready, never faked.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
